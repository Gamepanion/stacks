# Copy to .env next to compose.yaml and fill it in; on the server the deployment repository writes it. Every name Gamepanion
# reads is listed (backend/config.ts in gamepanion/gamepanion). A commented-out line keeps the image's own default.

# This server's address on the private network: Gamepanion listens there (port 8082), where Caddy passes requests on.
PRIVATE_IP=10.0.0.3

# The address players and Claude reach Gamepanion at. Sign-in, passkeys, the OAuth issuer and the MCP resource are built from it:
# changing it signs every connected Claude out and makes every passkey useless.
PUBLIC_URL=https://gamepanion.app

# Where gamepanion.sqlite, auth.sqlite, billing.sqlite (only with payments on) and the generated secret live. Default /data (./data here).
# DATA_DIR=/data

# Signs session cookies and encrypts the token signing keys: at least 32 bytes (openssl rand -hex 32). Unset: generated once into
# ${DATA_DIR}/secret. Changing it signs out every browser and every connected Claude.
GAMEPANION_SECRET=

# Who may become a player, comma-separated: addresses, @domain or *. Empty: nobody new (players who exist keep signing in).
GAMEPANION_SIGNUP_ALLOW=

# Sign-in with an emailed code and link, the only sign-in on gamepanion.app: an SMTP server
# (smtps://user:password@host:465) and the sender address.
GAMEPANION_SMTP_URL=
GAMEPANION_SMTP_FROM=

# Sign-in through an OpenID Connect provider: not used on gamepanion.app. A block per provider, <NAME> letters and digits; an
# issuer without a client id stops Gamepanion from starting.
# GAMEPANION_OIDC_<NAME>_ISSUER=
# GAMEPANION_OIDC_<NAME>_CLIENT_ID=
# GAMEPANION_OIDC_<NAME>_CLIENT_SECRET=
# GAMEPANION_OIDC_<NAME>_LABEL=

# The chat in the web app: a Claude API key turns it on. The model, and how many messages a player may send a day.
GAMEPANION_ANTHROPIC_API_KEY=
# GAMEPANION_ANTHROPIC_MODEL=claude-opus-5-5
# GAMEPANION_CHAT_DAILY_LIMIT=100

# Players' own Anthropic keys for the chat (ADR 0021): stored encrypted with this key, 32 bytes as hex (openssl rand -hex 32). Unset:
# players can't store a key. Like GAMEPANION_SECRET it is in no dump; a new one makes every stored key unreadable.
GAMEPANION_KEY_ENCRYPTION_KEY=

# The operator's pages (ADR 0023): Markdown files linked in the footer only when set; {lang} becomes en or de, falling back to en.
# Not set on gamepanion.app yet.
# GAMEPANION_IMPRINT_FILE=
# GAMEPANION_PRIVACY_FILE=
# GAMEPANION_TERMS_FILE=
# GAMEPANION_PRICING_FILE=

# Payments (ADR 0023, 0024): empty is off, every feature for every player, nothing sold. Off on gamepanion.app until Creem is set up;
# then creem with its key, products and webhook secret, and all four operator files.
# GAMEPANION_PAYMENT_PROVIDER=
# GAMEPANION_CREEM_API_KEY=
# GAMEPANION_CREEM_PRODUCT_ID=
# GAMEPANION_CREEM_YEARLY_PRODUCT_ID=
# GAMEPANION_CREEM_HOSTED_AI_PRODUCT_ID=
# GAMEPANION_CREEM_HOSTED_AI_YEARLY_PRODUCT_ID=
# GAMEPANION_CREEM_WEBHOOK_SECRET=
# GAMEPANION_FREE_PLAYERS=
# The hosted-AI plan's monthly quota and guardrails, only with payments on.
# GAMEPANION_AI_MONTHLY_TOKENS=2000000
# GAMEPANION_AI_MONTHLY_MINUTES=60
# GAMEPANION_AI_PER_MINUTE=6
# GAMEPANION_AI_REPLY_TOKENS=4000

# Speaking into the chat: compose.yaml points GAMEPANION_TRANSCRIBE_URL at its whisper service. The model whisper transcribes
# with; the deployment installs it into ./whisper. Default Systran/faster-whisper-small.
# GAMEPANION_TRANSCRIBE_MODEL=Systran/faster-whisper-small

# error, warn, info (default), debug or silent.
GAMEPANION_LOG_LEVEL=info

# "Today" (the default day of a session) is computed in this time zone.
TZ=Europe/Berlin
